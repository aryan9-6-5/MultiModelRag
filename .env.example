# Copy to .env and adjust as needed. All values shown are the defaults.

# Storage
DATA_DIR=./data
STORAGE_DIR=./storage

# Embeddings (OpenCLIP)
CLIP_MODEL_NAME=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k
EMBEDDING_DEVICE=auto

# Chunking
CHUNK_SIZE_TOKENS=220
CHUNK_OVERLAP_TOKENS=40

# Image enrichment
ENABLE_CAPTIONING=true
ENABLE_OCR=true
CAPTION_MODEL_NAME=Salesforce/blip-image-captioning-base

# Retrieval
DEFAULT_TOP_K=10
RERANK_TOP_K=5

# Generation (Ollama — local, no API key needed)
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=llama3.2:3b
LLM_FALLBACK_MODEL=qwen2.5:latest
GENERATION_TIMEOUT_S=60

# API
API_HOST=0.0.0.0
API_PORT=8000
